# Copiar a `.env` y completar. El `.env` está en .gitignore: nunca se commitea.
# cp .env.example .env

# --- Base de datos ---
# PostgreSQL (para desarrollo y producción).
# Estos valores coinciden con el contenedor de docker-compose.yml.
# Credenciales de desarrollo: usuario `futbot`, contraseña `futbot`, base `futbot`.
# Son solo para uso local; en producción se usan otras vía `DATABASE_URL`.
DATABASE_URL=postgresql+psycopg://futbot:futbot@localhost:5432/futbot


SECRET_KEY=<generala con: openssl rand -hex 32>
#JWT_ALGORITHM=HS256              # Algoritmo para firmar el token
#JWT_EXPIRE_MINUTES=30            # vida del access token
#REFRESH_EXPIRE_DAYS=7            # vida del refresh token

# --- Política de contraseñas ---
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128